{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
  
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
     "types": ["node"]
  },
  "include": ["./src/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules"]
}